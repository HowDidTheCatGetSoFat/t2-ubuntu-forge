[Unit]
Description=Cap sustained CPU power (T2 i9 anti-throttling)
# Must run BEFORE thermald: thermald captures the PL1 value present at its
# startup as the baseline it later restores. If it starts first it adopts
# the firmware's 100 W and keeps reverting the cap (seen on first reboot).
Before=thermald.service
After=suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target

[Service]
Type=oneshot
# NO RemainAfterExit: a oneshot left "active" is NOT re-run when
# suspend.target wants it again on resume, so the cap would not be
# reapplied after suspend (RAPL resets there). Dead-after-run means every
# activation - boot and each resume - actually executes.
ExecStart=/usr/local/sbin/t2-powercap.sh

[Install]
WantedBy=multi-user.target suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target
